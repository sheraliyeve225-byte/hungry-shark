import pygame
import random
import sys

# PyGame ni ishga tushirish
pygame.init()

# O'yin sozlamalari
WIDTH, HEIGHT = 800, 600
FPS = 60
WHITE = (255, 255, 255)
BLUE = (0, 120, 255)
GREEN = (0, 200, 100)
RED = (255, 50, 50)
YELLOW = (255, 255, 0)
BLACK = (0, 0, 0)

# O'yin oynasini yaratish
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Hungry Shark")
clock = pygame.time.Clock()

# Shark klassi
class Shark:
    def __init__(self):
        self.x = WIDTH // 2
        self.y = HEIGHT // 2
        self.width = 60
        self.height = 40
        self.speed = 5
        self.score = 0
        self.level = 1
        
    def draw(self):
        # Shark tanasi
        pygame.draw.ellipse(screen, BLUE, (self.x, self.y, self.width, self.height))
        
        # Shark dumlari
        pygame.draw.polygon(screen, BLUE, [
            (self.x, self.y + self.height // 4),
            (self.x - 20, self.y),
            (self.x - 20, self.y + self.height // 2)
        ])
        
        # Shark og'zi
        pygame.draw.ellipse(screen, RED, (self.x + self.width - 15, self.y + 10, 25, 20))
        
        # Shark ko'zlari
        pygame.draw.circle(screen, WHITE, (self.x + self.width - 10, self.y + 15), 6)
        pygame.draw.circle(screen, BLACK, (self.x + self.width - 10, self.y + 15), 3)
        
        # Shark qanotlari
        pygame.draw.ellipse(screen, BLUE, (self.x + 10, self.y - 10, 20, 15))
        pygame.draw.ellipse(screen, BLUE, (self.x + 10, self.y + self.height - 5, 20, 15))
    
    def move(self, keys):
        if keys[pygame.K_LEFT] or keys[pygame.K_a]:
            self.x -= self.speed
        if keys[pygame.K_RIGHT] or keys[pygame.K_d]:
            self.x += self.speed
        if keys[pygame.K_UP] or keys[pygame.K_w]:
            self.y -= self.speed
        if keys[pygame.K_DOWN] or keys[pygame.K_s]:
            self.y += self.speed
        
        # Cheklovlar
        self.x = max(0, min(self.x, WIDTH - self.width))
        self.y = max(0, min(self.y, HEIGHT - self.height))
    
    def get_rect(self):
        return pygame.Rect(self.x, self.y, self.width, self.height)

# Baliq klassi
class Fish:
    def __init__(self):
        self.size = random.randint(10, 30)
        self.x = random.randint(0, WIDTH - self.size)
        self.y = random.randint(0, HEIGHT - self.size)
        self.color = (random.randint(0, 255), random.randint(0, 255), random.randint(0, 255))
        self.speed_x = random.choice([-2, -1, 1, 2])
        self.speed_y = random.choice([-2, -1, 1, 2])
        
    def draw(self):
        pygame.draw.ellipse(screen, self.color, (self.x, self.y, self.size, self.size // 2))
        # Baliq dumlari
        pygame.draw.polygon(screen, self.color, [
            (self.x, self.y + self.size // 4),
            (self.x - 10, self.y),
            (self.x - 10, self.y + self.size // 2)
        ])
        # Baliq ko'zlari
        pygame.draw.circle(screen, WHITE, (self.x + self.size - 5, self.y + self.size // 4), 3)
    
    def move(self):
        self.x += self.speed_x
        self.y += self.speed_y
        
        # Cheklovlar
        if self.x <= 0 or self.x >= WIDTH - self.size:
            self.speed_x *= -1
        if self.y <= 0 or self.y >= HEIGHT - self.size:
            self.speed_y *= -1
    
    def get_rect(self):
        return pygame.Rect(self.x, self.y, self.size, self.size // 2)

# O'yinni boshqarish funksiyasi
def main():
    shark = Shark()
    fishes = [Fish() for _ in range(15)]
    game_over = False
    font = pygame.font.SysFont(None, 36)
    
    # O'yin asosiy tsikli
    running = True
    while running:
        # Hodisalarni tekshirish
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_ESCAPE:
                    running = False
                if game_over and event.key == pygame.K_r:
                    # O'yinni qayta boshlash
                    shark = Shark()
                    fishes = [Fish() for _ in range(15)]
                    game_over = False
        
        if not game_over:
            # Sharkni harakatlantirish
            keys = pygame.key.get_pressed()
            shark.move(keys)
            
            # Baliqlarni harakatlantirish
            for fish in fishes:
                fish.move()
                
                # Baliqni yeyishni tekshirish
                if shark.get_rect().colliderect(fish.get_rect()):
                    shark.score += 1
                    fishes.remove(fish)
                    fishes.append(Fish())
                    
                    # Har 5 ta baliqda darajani oshirish
                    if shark.score % 5 == 0:
                        shark.level += 1
                        shark.speed += 0.5
                        
                        # Yangi baliq qo'shish
                        for _ in range(2):
                            fishes.append(Fish())
        
        # Ekranni chizish
        screen.fill((0, 50, 100))  # Dengiz rangi
        
        # Sharkni chizish
        shark.draw()
        
        # Baliqlarni chizish
        for fish in fishes:
            fish.draw()
        
        # O'yin ma'lumotlarini chizish
        score_text = font.render(f"Ball: {shark.score}", True, WHITE)
        level_text = font.render(f"Daraja: {shark.level}", True, WHITE)
        control_text = font.render("Harakat: W A S D yoki O'q tugmalari", True, WHITE)
        
        screen.blit(score_text, (10, 10))
        screen.blit(level_text, (10, 50))
        screen.blit(control_text, (WIDTH - 350, 10))
        
        # O'yin tugashi (agar shark juda kichik baliqlarni yemasa)
        if shark.score > 0 and len(fishes) > 20:
            game_over = True
            over_text = font.render("OYIN TUGADI! R - qayta boshlash, ESC - chiqish", True, RED)
            screen.blit(over_text, (WIDTH // 2 - 300, HEIGHT // 2))
        
        # Ekranni yangilash
        pygame.display.flip()
        clock.tick(FPS)
    
    pygame.quit()
    sys.exit()

# O'yinni ishga tushirish
if __name__ == "__main__":
    main()
